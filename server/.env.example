PORT=5000

MONGO_URI=

JWT_SECRET=
JWT_EXPIRES_IN=1d

CLIENT_URL=http://localhost:5173

# ── Google Sheets KCode Authentication ────────────────────────────────────────
# Extract the Sheet ID from the Google Sheets URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=

# The tab/sheet name to use (default: Sheet1).
# Column order and header-row position are discovered dynamically —
# do NOT hard-code GOOGLE_SHEET_RANGE or assume Column A = KCode etc.
GOOGLE_SHEET_NAME=Sheet1

# ── NOC Request submissions ──────────────────────────────────────────────────
# Share this spreadsheet with the service account as an Editor. The service
# locates these required headers dynamically, regardless of row/column order:
# Timestamp, Email Address, Job No, Job Name, Current Status.
GOOGLE_NOC_REQUEST_SHEET_ID=
GOOGLE_NOC_REQUEST_SHEET_NAME=Sheet1

# Service-account credentials from the Google Cloud Console JSON key file.
# The service account MUST be shared on the Google Sheet with Editor permission
# (not Viewer), because the application writes updated passwords back to the
# Sheet when users change their passwords.
# NEVER commit the real .env file to Git.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Paste the private_key value from the JSON credentials file exactly.
# Keep \\n as literal characters inside the double-quoted string.
GOOGLE_PRIVATE_KEY=""
